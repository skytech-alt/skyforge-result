// skyforge-result
// Реализация Result и Option через словари для максимальной
// совместимости и простоты.

// ---------- Result ----------

функция успех(значение) {
    вернуть {"тег": "Ok", "значение": значение}
}

функция ошибка(значение) {
    вернуть {"тег": "Err", "значение": значение}
}

функция это_успех(рез) {
    вернуть рез["тег"] == "Ok"
}

функция это_ошибка(рез) {
    вернуть рез["тег"] == "Err"
}

функция развернуть(рез) {
    если это_ошибка(рез) {
        ошибка_runtime("unwrap() on Err: " + строка(рез["значение"]))
    }
    вернуть рез["значение"]
}

функция развернуть_или(рез, по_умолчанию) {
    если это_успех(рез) {
        вернуть рез["значение"]
    }
    вернуть по_умолчанию
}

// ---------- Option ----------

функция есть(значение) {
    вернуть {"тег": "Some", "значение": значение}
}

функция нет() {
    вернуть {"тег": "Nothing"}
}

функция это_есть(опт) {
    вернуть опт["тег"] == "Some"
}

функция это_нет(опт) {
    вернуть опт["тег"] == "Nothing"
}

функция развернуть_опт(опт) {
    если это_нет(опт) {
        ошибка_runtime("unwrap() on Nothing")
    }
    вернуть опт["значение"]
}

функция развернуть_опт_или(опт, по_умолчанию) {
    если это_есть(опт) {
        вернуть опт["значение"]
    }
    вернуть по_умолчанию
}
